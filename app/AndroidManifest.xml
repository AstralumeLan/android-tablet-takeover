<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.astra.takeover" android:versionCode="6" android:versionName="2.4">
  <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="33"/>
  <permission android:name="com.astra.takeover.permission.CONTROL" android:protectionLevel="signature"/>
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
  <application android:label="接管状态条" android:allowBackup="false">
    <activity android:name=".MainActivity" android:exported="true" android:label="接管状态条" android:excludeFromRecents="true">
      <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
    </activity>
    <service android:name=".TakeoverService" android:exported="false"/>
    <receiver android:name=".Cmd" android:exported="true">
      <intent-filter><action android:name="com.astra.takeover.STATUS"/><action android:name="com.astra.takeover.SHOW"/><action android:name="com.astra.takeover.HIDE"/><action android:name="com.astra.takeover.DRYRUN"/></intent-filter>
    </receiver>
    <!-- lock control: only root/system (uid 0/1000 bypass permission checks) or apps signed with our key -->
    <receiver android:name=".Ctl" android:exported="true" android:permission="com.astra.takeover.permission.CONTROL">
      <intent-filter><action android:name="com.astra.takeover.LOCK"/><action android:name="com.astra.takeover.UNLOCK"/><action android:name="com.astra.takeover.SETPIN"/><action android:name="com.astra.takeover.CLEARPIN"/><action android:name="com.astra.takeover.STATE"/><action android:name="com.astra.takeover.TESTFAILS"/><action android:name="com.astra.takeover.DUMP"/><action android:name="com.astra.takeover.CLICK"/></intent-filter>
    </receiver>
    <service android:name=".Ui" android:exported="false" android:label="接管界面读取" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter><action android:name="android.accessibilityservice.AccessibilityService"/></intent-filter>
      <meta-data android:name="android.accessibilityservice" android:resource="@xml/a11y"/>
    </service>
    <receiver android:name=".Boot" android:exported="true">
      <intent-filter><action android:name="android.intent.action.BOOT_COMPLETED"/><action android:name="android.intent.action.MY_PACKAGE_REPLACED"/></intent-filter>
    </receiver>
  </application>
</manifest>
